# Jangan isi manual — jalankan `npm run setup` dari folder root proyek.
PORT='3001'
ADMIN_PASSWORD_HASH='diisi-otomatis-oleh-setup'

# Notifikasi Telegram — isi lewat `npm run setup:telegram`
# TELEGRAM_BOT_TOKEN='...'
# TELEGRAM_CHAT_ID='...'
# PUBLIC_URL='https://domainmu.com'   # supaya notifikasi berisi link ke inbox

# Opsional
# DB_PATH='./data/whistle.db'
# TRUST_PROXY='1'   # WAJIB saat di-hosting di belakang proxy (Render, Railway, Nginx, dll)
